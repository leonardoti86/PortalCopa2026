<div class="ranking-tabela-wrap">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Pos.</th>
                <th>Seleção</th>
                <th>Pontos</th>
                <th>Grupo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Itens)
            {
                <tr>
                    <td>@item.Posicao</td>
                    <td class="ranking-tabela__selecao">
                        <img class="ranking-tabela__flag" src="https://api.fifa.com/api/v3/picture/flags-sq-4/@item.SelecaoCodigo" alt="Bandeira de @item.SelecaoNome" loading="lazy" onerror="this.style.visibility='hidden'" />
                        <span>@item.SelecaoNome</span>
                    </td>
                    <td>@item.Pontos.ToString("F2")</td>
                    <td>Grupo @item.Grupo</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RankingPosicaoDto> Itens { get; set; } = Array.Empty<RankingPosicaoDto>();
}
