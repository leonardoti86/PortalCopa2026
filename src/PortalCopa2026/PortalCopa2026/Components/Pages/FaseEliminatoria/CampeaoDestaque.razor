@using PortalCopa2026.Services.FinalCopa.Dtos

<div class="campeao-destaque">
    <div class="campeao-destaque__confete" aria-hidden="true">
        @for (var i = 0; i < QuantidadeConfetes; i++)
        {
            var estilo = ObterEstiloConfete(i);
            <span class="campeao-destaque__confete-item" style="@estilo"></span>
        }
    </div>

    @* Ícone da Bootstrap Icons (bi-trophy-fill, MIT) embutido como SVG inline: o projeto não carrega
       a fonte de ícones da Bootstrap Icons (NavMenu.razor.css só define os ícones específicos do
       menu como SVGs de fundo), então "bi bi-trophy-fill" sozinho não renderiria nada. *@
    <svg class="campeao-destaque__taca" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5q0 .807-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935" />
    </svg>

    <img class="campeao-destaque__bandeira" src="https://api.fifa.com/api/v3/picture/flags-sq-4/@Campeao.Codigo"
         alt="Bandeira de @Campeao.Nome" loading="lazy" onerror="this.style.visibility='hidden'" />

    <p class="campeao-destaque__subtitulo">Campeão da Copa do Mundo FIFA 2026</p>
    <h2 class="campeao-destaque__nome">@Campeao.Nome</h2>
    <p class="campeao-destaque__titulos">
        @Campeao.TitulosMundiais @(Campeao.TitulosMundiais == 1 ? "título mundial conquistado até 2022" : "títulos mundiais conquistados até 2022")
    </p>
</div>

@code {
    private const int QuantidadeConfetes = 40;

    private static readonly string[] CoresConfete = ["#f2b705", "#ffffff", "#0a6e3a", "#0b1f3a"];

    [Parameter, EditorRequired]
    public CampeaoDto Campeao { get; set; } = null!;

    // Random.Shared: thread-safe (várias sessões Blazor Server podem renderizar este componente
    // concorrentemente); posições puramente decorativas, sem necessidade de determinismo.
    private static string ObterEstiloConfete(int indice)
    {
        var esquerda = Random.Shared.Next(0, 100);
        var atraso = (Random.Shared.NextDouble() * 2.5).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var duracao = (2.5 + Random.Shared.NextDouble() * 1.5).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var cor = CoresConfete[indice % CoresConfete.Length];

        return $"left: {esquerda}%; animation-delay: {atraso}s; animation-duration: {duracao}s; background-color: {cor};";
    }
}
